
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Just a Moment...</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      text-align: center;
    }

    .container {
      background: rgba(255, 255, 255, 0.1);
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
      max-width: 600px;
    }

    h1 {
      font-size: 2.5em;
      margin-bottom: 20px;
    }

    p {
      font-size: 1.2em;
      margin-bottom: 20px;
    }

    .loader {
      border: 8px solid #f3f3f3;
      border-top: 8px solid #3498db;
      border-radius: 50%;
      width: 60px;
      height: 60px;
      animation: spin 1s linear infinite;
      margin: 20px auto;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    a {
      color: #00c3ff;
      text-decoration: underline;
      font-weight: bold;
    }
  </style>
  <script>
    const links = [
      "https://earphonescharornament.com/e9nad8ed?key=8fcdd35f48d0e235ec1bcb80f9f40035",
      "https://earphonescharornament.com/zt3u3mrs?key=a9220f0eabbd39cc1ee9be64e5df7186",
      "https://earphonescharornament.com/bg91y0uia?key=b0552e8a3f6e7cca6f1904eda6e27072",
      "https://earphonescharornament.com/a89p9bv8?key=006a5e1214365bc5551ce08d9365adce",
      "https://earphonescharornament.com/h7n25ntnz?key=83589807e4c7bfe84965b7a03f9c75d9",
      "https://earphonescharornament.com/kjgxgnkh9?key=e9523e16792ec3528b61254bf9d85236"
    ];
    const randomIndex = Math.floor(Math.random() * links.length);
    setTimeout(() => {
      window.open(links[randomIndex], '_blank');
    }, 3000);
  </script>
</head>
<body>
  <div class="container">
    <h1>Just a Moment...</h1>
    <div class="loader"></div>
    <p>We are redirecting you to the best offer available. This won’t take long.</p>
    <p>If nothing happens, <a id="fallback" href="#">click here</a>.</p>
  </div>
  <script>
    document.getElementById('fallback').href = links[Math.floor(Math.random() * links.length)];
  </script>
</body>
</html>
